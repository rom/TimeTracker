# Environment for the TimeTracker service.
#
# Install to /etc/timetracker.env with mode 0600, owned by root. It holds
# secrets, and a world-readable environment file is a common quiet mistake.
#
#   sudo install -m 0600 -o root -g root deploy/systemd/timetracker.env /etc/timetracker.env

# Where to listen. Bind loopback and put a reverse proxy in front, or bind
# publicly and give the service its own certificate (see scripts/gen-cert.sh).
TT_ADDR=127.0.0.1:8420

# TLS terminated by this process. Omit both when a reverse proxy does it, and
# set TT_SECURE_COOKIES=1 instead so the cookie still carries the Secure flag.
#TT_TLS_CERT=/etc/timetracker/server.crt
#TT_TLS_KEY=/etc/timetracker/server.key
#TT_SECURE_COOKIES=1

# The addresses of reverse proxies whose X-Forwarded-For header may be believed.
# Leave empty if nothing proxies this service: an unchecked forwarded header
# makes the audit trail record whatever an attacker types.
#TT_TRUSTED_PROXIES=127.0.0.1

# The first administrator, created once on an empty instance and ignored
# afterwards. Remove these two lines after the first successful start.
#TT_ADMIN_EMAIL=admin@example.com
#TT_ADMIN_PASSWORD=

# Single sign-on. All four are required together.
#TT_OIDC_ISSUER=https://login.example.com/tenant
#TT_OIDC_CLIENT_ID=
#TT_OIDC_CLIENT_SECRET=
#TT_OIDC_REDIRECT_URL=https://timetracker.example.com/auth/oidc/callback
#TT_OIDC_ROLE_CLAIM=groups
#TT_OIDC_ROLE_MAPPING=timetracker-admins=admin,timetracker-leads=manager

# Syslog. Detected automatically on a systemd host; set these to forward to a
# remote collector instead.
#TT_SYSLOG_NETWORK=tcp+tls
#TT_SYSLOG_ADDRESS=logs.example.com:6514

TT_LOG_LEVEL=info
TT_LOG_FORMAT=json
